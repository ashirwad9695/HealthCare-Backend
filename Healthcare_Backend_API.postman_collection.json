{
  "info": {
    "name": "Healthcare Backend API",
    "description": "Postman Collection for testing Healthcare Backend API endpoints (Authentication, Patients, Doctors, Mappings).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.tokens) {",
                  "    pm.collectionVariables.set('access_token', jsonData.data.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.data.tokens.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Jane Foster\",\n  \"email\": \"jane.foster@healthcare.com\",\n  \"password\": \"SecurePass@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.tokens) {",
                  "    pm.collectionVariables.set('access_token', jsonData.data.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.data.tokens.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            }
          }
        },
        {
          "name": "Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Patient Management",
      "item": [
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Michael Scott\",\n  \"date_of_birth\": \"1965-03-15\",\n  \"age\": 59,\n  \"gender\": \"Male\",\n  \"contact_number\": \"+15551239876\",\n  \"email\": \"mscott@dundermifflin.com\",\n  \"address\": \"Scranton, PA\",\n  \"medical_history\": \"Burned foot on George Foreman grill.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", ""]
            }
          }
        },
        {
          "name": "Retrieve All Patients Created by Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", ""]
            }
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "1", ""]
            }
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Walker Updated\",\n  \"age\": 35,\n  \"gender\": \"Female\",\n  \"contact_number\": \"+15550111222\",\n  \"address\": \"742 Evergreen Terrace, Springfield\",\n  \"medical_history\": \"Asthma controlled with inhaler.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "1", ""]
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "1", ""]
            }
          }
        }
      ]
    },
    {
      "name": "3. Doctor Management",
      "item": [
        {
          "name": "Add Doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cristina Yang\",\n  \"specialization\": \"Cardiothoracic Surgery\",\n  \"email\": \"cristina.yang@klausman.ch\",\n  \"phone_number\": \"+15553334444\",\n  \"years_of_experience\": 14,\n  \"hospital_affiliation\": \"Klausman Institute for Medical Research\",\n  \"bio\": \"World-renowned cardiothoracic surgeon and researcher.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", ""]
            }
          }
        },
        {
          "name": "Retrieve All Doctors",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", ""]
            }
          }
        },
        {
          "name": "Get Specific Doctor",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "1", ""]
            }
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gregory House, M.D.\",\n  \"specialization\": \"Diagnostic Medicine & Infectious Diseases\",\n  \"email\": \"gregory.house@princeton.edu\",\n  \"phone_number\": \"+15550192834\",\n  \"years_of_experience\": 23,\n  \"hospital_affiliation\": \"Princeton-Plainsboro\",\n  \"bio\": \"Lead diagnostic physician specializing in puzzling medical cases.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "1", ""]
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "1", ""]
            }
          }
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mapping",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": 1,\n  \"doctor\": 3,\n  \"notes\": \"Referred for neurological follow-up after migraines.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            }
          }
        },
        {
          "name": "Retrieve All Mappings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            }
          }
        },
        {
          "name": "Get Doctors Assigned to Specific Patient",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", "1", ""]
            }
          }
        },
        {
          "name": "Remove Doctor from Patient (Delete Mapping)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", "1", ""]
            }
          }
        }
      ]
    }
  ]
}
